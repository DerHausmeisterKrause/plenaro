# Kopiere diese Datei nach .env und setze ein zufaelliges Passwort.
# NIE .env committen. Sonderzeichen wie ';' im Passwort vermeiden (Connection String).
POSTGRES_DB=plenaro
POSTGRES_USER=plenaro
POSTGRES_PASSWORD=
PLENARO_HTTP_PORT=8080

# Standard: auf allen Host-Interfaces erreichbar (LAN). Nur im vertrauenswürdigen Netzwerk verwenden.
# Für ausschließlich lokalen Zugriff: 127.0.0.1
PLENARO_BIND_IP=0.0.0.0

# Nur für den optionalen HTTPS-Compose-Overlay:
# PLENARO_HTTPS_HOST=192.168.178.50  (echte Host-IP statt Beispiel)
# PLENARO_HTTPS_BIND_IP=0.0.0.0
